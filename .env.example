# Server-side defaults. Copy to .env. Every one of these can be overridden per
# user in the UI (typed for one request, or saved encrypted on the server).
# Values are never sent to the browser; the UI only learns that a default exists.

# OpenAI key used when the user hasn't entered their own. (OPENAI_API_KEY also works.)
OPENAI_KEY=
# Default model pre-selected in the UI (optional), e.g. gpt-4.1-mini
OPENAI_MODEL=

# Vercel token and team used for Deploy when the user hasn't entered their own.
# (VERCEL_TEAM_ID also works for TEAM_ID.) Leave TEAM_ID empty for a personal account.
VERCEL_TOKEN=
TEAM_ID=

# Job Fetcher (the monorepo's job collector). Pasting an Upwork job ID or URL and
# clicking Fetch fills in the brief. Define one or both sources; the UI has a
# Local / Production switch. URLs are .env-only (the UI picks a source, never a URL);
# each source's key can be overridden in the UI.
JOB_FETCHER_LOCAL_URL=http://localhost:3004
JOB_FETCHER_LOCAL_API_KEY=
JOB_FETCHER_PROD_URL=https://jobfetcher.signity.solutions
JOB_FETCHER_PROD_API_KEY=
# Which source is selected first: local or production
JOB_FETCHER_TARGET=local

# ---- Hosting on Vercel (see README, "Deploying to Vercel") ----
# Postgres for saved keys (Aiven). Vercel has no persistent disk, so these are required there.
DATABASE_URL=
# Aiven's ca.pem, base64-encoded: base64 -w0 ca.pem
DATABASE_CA_CERT_B64=
# Long random string that encrypts saved keys: openssl rand -hex 32
CREDENTIAL_SECRET=
# Optional shared password. Set both to put the whole app behind a sign-in screen.
APP_PASSWORD=
SESSION_SECRET=

# Optional
# PORT=8787
# RATE_LIMIT_PER_MIN=12   # generate/deploy calls per minute per client
# DATA_DIR=.data
# CREDENTIAL_SECRET=   # encrypts keys users choose to save; generated into DATA_DIR if unset
